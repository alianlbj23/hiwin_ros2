# Copy to .env and edit.
ROBOT_IP=192.168.0.1      # HIWIN GC2 controller IP (./run.py -> 0 -> 2 scans for it, TCP port 1503)
RA_TYPE=ra610_1476        # ra605_710 | ra610_1355 | ra610_1476 | ra610_1869
ROS_DOMAIN_ID=0
LAUNCH_RVIZ=true
# Remote desktop (./run.py -> 9, or `docker compose up -d desktop`), user `ros`.
# Password for VNC, SSH and sudo: 6-8 characters, letters, digits or . _ @ ! % + = -
VNC_PASSWORD=
VNC_PORT=5901             # VNC viewer
NOVNC_PORT=8080           # browser: http://<host>:8080/vnc.html
SSH_PORT=2222             # ssh -p 2222 ros@<host>
